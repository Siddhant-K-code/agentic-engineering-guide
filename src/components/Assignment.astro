---
interface Props {
  chapter: number;
  title: string;
  starterFile: string;
  onaUrl: string;
  localUrl: string;
}

const { chapter, title, starterFile, onaUrl, localUrl } = Astro.props;
const chapterSlug = `ch${String(chapter).padStart(2, "0")}`;
---

<section class="assignment-block not-prose mt-16 mb-4">
  <!-- Header bar -->
  <div class="assignment-header">
    <div class="assignment-header-left">
      <span class="assignment-eyebrow">Practical Assignment</span>
      <h2 class="assignment-title">{title}</h2>
    </div>
    <div class="assignment-actions">
      <a
        href={onaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ona"
        title="Open in Ona — pre-configured environment, no setup required"
        data-track="assignment_open_ona"
        data-chapter={chapterSlug}
      >
        <!-- Light mode: black symbol -->
        <svg class="ona-symbol ona-symbol-light" width="14" height="14" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M193.143 58.5714C197.143 62.5714 199.714 68 199.714 74.2857V126C199.714 132.286 197.143 137.714 193.143 141.714L141.429 193.429C137.429 197.714 131.714 200 125.714 200H74C67.7143 200 62.2857 197.714 58 193.429L6.28571 141.714C2.28571 137.714 0 132.286 0 126V74.2857C0 68 2.28571 62.5714 6.28571 58.2857L58 6.57143C62.2857 2.57143 67.7143 0 74 0H125.714C131.714 0 137.429 2.57143 141.429 6.85714L193.143 58.5714ZM152.345 130.345V69.9407C152.345 57.655 142.345 47.3693 130.059 47.3693H69.655C57.0836 47.3693 47.0836 57.655 47.0836 69.9407V130.345C47.0836 142.631 57.0836 152.631 69.655 152.631H130.059C142.345 152.631 152.345 142.631 152.345 130.345Z" fill="black"/>
        </svg>
        <!-- Dark mode: white symbol -->
        <svg class="ona-symbol ona-symbol-dark" width="14" height="14" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M185.417 56.2286C189.257 60.0686 191.726 65.28 191.726 71.3143V120.96C191.726 126.994 189.257 132.206 185.417 136.046L135.771 185.691C131.931 189.806 126.446 192 120.686 192H71.04C65.0057 192 59.7943 189.806 55.68 185.691L6.03428 136.046C2.19428 132.206 0 126.994 0 120.96V71.3143C0 65.28 2.19428 60.0686 6.03428 55.9543L55.68 6.30857C59.7943 2.46857 65.0057 0 71.04 0H120.686C126.446 0 131.931 2.46858 135.771 6.58286L185.417 56.2286ZM146.251 125.131V67.1431C146.251 55.3488 136.651 45.4745 124.857 45.4745H66.8688C54.8002 45.4745 45.2002 55.3488 45.2002 67.1431V125.131C45.2002 136.925 54.8002 146.525 66.8688 146.525H124.857C136.651 146.525 146.251 136.925 146.251 125.131Z" fill="#FDFDFD"/>
        </svg>
        <span>Open in Ona</span>
      </a>
      <a
        href={localUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-local"
        data-track="assignment_download_starter"
        data-chapter={chapterSlug}
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download starter
      </a>
    </div>
  </div>

  <!-- Body -->
  <div class="assignment-body">
    <!-- Starter file pill -->
    <div class="assignment-starter-row">
      <span class="starter-label">Starter</span>
      <code class="starter-filename">{starterFile}</code>
      <span class="starter-hint">modify and run</span>
    </div>

    <!-- Slot: assignment content -->
    <div class="assignment-content prose-assignment">
      <slot />
    </div>

    <!-- Footer: local setup note -->
    <div class="assignment-footer">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span>
        No API key needed. A mock server starts automatically in the Ona environment.
        To use a real model, add <code>OPENAI_API_KEY</code> as an <a href="https://app.gitpod.io/ai?user-settings=secrets" target="_blank" rel="noopener noreferrer">Ona User Secret</a>. The starter detects it and switches with no code changes. <a href="https://ona.com/docs/ona/configuration/secrets/user-secrets" target="_blank" rel="noopener noreferrer">How to add a secret.</a>
      </span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-track]").forEach((el) => {
    el.addEventListener("click", () => {
      const event = el.dataset.track;
      const chapter = el.dataset.chapter;
      if (typeof window.gtag === "function") {
        window.gtag("event", event, {
          event_category: "practical_track",
          event_label: chapter,
        });
      }
    });
  });
</script>

<style>
  /* ── Block shell ── */
  .assignment-block {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-primary);
  }

  /* ── Header ── */
  .assignment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .assignment-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .assignment-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .assignment-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  /* ── Action buttons ── */
  .assignment-actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .btn-ona {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 32px;
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 5px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .btn-ona:hover {
    border-color: var(--text-tertiary);
    background: var(--bg-hover);
  }

  .ona-symbol {
    flex-shrink: 0;
    display: block;
  }

  /* Show black symbol in light mode, hide white */
  .ona-symbol-light { display: block; }
  .ona-symbol-dark  { display: none;  }

  /* Swap in dark mode — :global(.dark) prevents Astro scoping the ancestor */
  :global(.dark) .ona-symbol-light { display: none;  }
  :global(.dark) .ona-symbol-dark  { display: block; }

  .btn-local {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0 0.75rem;
    height: 32px;
    background: var(--bg-primary);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .btn-local:hover {
    color: var(--text-primary);
    border-color: var(--text-tertiary);
    background: var(--bg-hover);
  }

  /* ── Body ── */
  .assignment-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Starter row ── */
  .assignment-starter-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .starter-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .starter-filename {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .starter-hint {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-style: italic;
  }

  /* ── Assignment content (prose inside the block) ── */
  .prose-assignment {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-primary);
  }

  .prose-assignment :global(h3) {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 1.25rem 0 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .prose-assignment :global(h3:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .prose-assignment :global(p) {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
  }

  .prose-assignment :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose-assignment :global(ol) {
    padding-left: 1.25rem;
    margin: 0.5rem 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .prose-assignment :global(ol li) {
    list-style-type: decimal;
    color: var(--text-secondary);
    padding-left: 0.25rem;
  }

  .prose-assignment :global(ul) {
    padding-left: 1.25rem;
    margin: 0.5rem 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .prose-assignment :global(ul li) {
    list-style-type: disc;
    color: var(--text-secondary);
    padding-left: 0.25rem;
  }

  .prose-assignment :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .prose-assignment :global(code) {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  .prose-assignment :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--border);
  }

  .prose-assignment :global(a:hover) {
    text-decoration-color: var(--text-primary);
  }

  /* ── Divider between sections ── */
  .prose-assignment :global(hr) {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 1rem 0;
  }

  /* ── Footer ── */
  .assignment-footer {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .assignment-footer svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .assignment-footer :global(a) {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--border);
  }

  .assignment-footer :global(a:hover) {
    color: var(--text-primary);
  }

  .assignment-footer code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .assignment-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .assignment-actions {
      width: 100%;
    }

    .btn-local {
      flex: 1;
      justify-content: center;
    }
  }
</style>
